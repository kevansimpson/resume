<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kevan Simpson - Resume</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Calibri', 'Arial', sans-serif;
            line-height: 1.25;
            color: #333;
            max-width: 8.5in;
            margin: 0 auto;
            padding: 0.35in 0.5in;
            font-size: 9.5pt;
        }
        
        @page {
            margin: 0;
        }
        
        h1 {
            font-size: 22pt;
            font-weight: bold;
            margin-bottom: 6px;
            color: #1a1a1a;
        }
        
        .contact {
            font-size: 8.5pt;
            color: #666;
            margin-bottom: 8px;
        }
        
        .contact a {
            color: #0066cc;
            text-decoration: none;
        }
        
        .summary {
            font-size: 9.5pt;
            line-height: 1.35;
            margin-bottom: 10px;
            text-align: justify;
        }
        
        h2 {
            font-size: 12pt;
            font-weight: bold;
            border-bottom: 1.5px solid #333;
            margin-top: 10px;
            margin-bottom: 5px;
            padding-bottom: 1px;
        }
        
        .job {
            margin-bottom: 8px;
        }
        
        .job-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 1px;
        }
        
        .job-title-company {
            display: flex;
            align-items: baseline;
            gap: 8px;
        }
        
        .job-title {
            font-weight: bold;
            font-size: 10pt;
        }
        
        .company {
            font-size: 9.5pt;
            color: #444;
        }
        
        .company a {
            color: #444;
            text-decoration: none;
        }
        
        .company a:hover {
            color: #0066cc;
            text-decoration: underline;
        }
        
        .job-date {
            font-size: 8.5pt;
            color: #666;
            font-style: italic;
            flex-shrink: 0;
        }
        
        .impact-statement {
            font-style: italic;
            color: #444;
            margin-bottom: 2px;
            font-size: 9pt;
        }
        
        ul {
            margin-left: 18px;
            margin-bottom: 4px;
        }
        
        li {
            margin-bottom: 1.5px;
            font-size: 9pt;
            line-height: 1.3;
        }
        
        .education {
            font-size: 9pt;
            margin-bottom: 2px;
        }
        
        .strengths {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            font-size: 9pt;
        }
        
        .strength-item {
            margin-bottom: 3px;
        }
        
        .strength-title {
            font-weight: bold;
            color: #1a1a1a;
        }
        
        @media print {
            body {
                padding: 0.3in 0.4in;
            }
        }
    </style>
</head>
<body>
